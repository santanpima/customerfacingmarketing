---
import { planFigure } from "../content/copy";
---

<figure class="plan-figure">
  <img
    src={planFigure.src}
    width={planFigure.width}
    height={planFigure.height}
    alt={planFigure.alt}
  />
  <figcaption>{planFigure.caption}</figcaption>
</figure>

<style>
  .plan-figure {
    max-width: var(--measure);
    margin: 1rem 0 0;
  }

  .plan-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-dark-blue);
    background: var(--color-white);
  }

  .plan-figure figcaption {
    margin-top: 0.65rem;
    max-width: var(--measure);
  }
</style>
