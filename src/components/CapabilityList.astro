---
import { lightSchedulerCapabilities } from "../content/copy";

interface Props {
  /** Product page: ordered steps with the explanation under each name. */
  ordered?: boolean;
  /** Home page: the five names only. The sentences stay on the product walkthrough. */
  namesOnly?: boolean;
}

const { ordered = false, namesOnly = false } = Astro.props;
---

{
  namesOnly ? (
    <ol class="step-strip">
      {lightSchedulerCapabilities.map((item, index) => (
        <li>
          <b>{index + 1}</b>
          <span>{item.name}</span>
        </li>
      ))}
    </ol>
  ) : ordered ? (
    <ol class="step-strip step-strip-detail">
      {lightSchedulerCapabilities.map((item, index) => (
        <li>
          <b>{index + 1}</b>
          <div>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <ul class="module-list">
      {lightSchedulerCapabilities.map((item) => (
        <li>
          <h3>{item.name}</h3>
          <p>{item.detail}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .step-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 1rem;
    max-width: none;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step-strip li {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.65rem;
    border-top: 2px solid var(--color-dark-blue);
  }

  .step-strip b {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .step-strip span,
  .step-strip h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .step-strip p {
    margin: 0.35rem 0 0;
    max-width: none;
  }

  @media (min-width: 48rem) {
    .step-strip {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .step-strip-detail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .step-strip-detail {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
