---
import CapabilityList from "../components/CapabilityList.astro";
import CtaRow from "../components/CtaRow.astro";
import PlanFigure from "../components/PlanFigure.astro";
import {
  assistantSummary,
  audienceCue,
  homeBuying,
  homeClose,
  homeLede,
  homepageHeadline,
  intentRoutes,
  laterModulesFollow,
  lightSchedulerIntro,
  seatIncludes,
  seo,
  trialNote,
  whoLead,
  whoUses,
} from "../content/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <h1>{homepageHeadline}</h1>
  <p>{homeLede}</p>
  <CtaRow />
  <nav aria-label="On this site">
    <ul class="intent-list">
      {
        intentRoutes.map((route) => (
          <li>
            <a href={route.href}>
              {route.label}
              <span>{route.detail}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section>
    <h2>What Light Scheduler is</h2>
    <p>{lightSchedulerIntro}</p>
    <PlanFigure />
    <CapabilityList namesOnly />
  </section>

  <section>
    <h2>The Assistant</h2>
    <p>{assistantSummary}</p>
  </section>

  <section>
    <h2>Who it is for</h2>
    <p>{whoLead}</p>
    <ul class="scan-list">
      {whoUses.map((use) => <li>{use}</li>)}
    </ul>
    <p>{audienceCue}</p>
  </section>

  <section>
    <h2>What a seat includes</h2>
    <p>
      {seatIncludes}
      <a href="/product#included">See the product page.</a>
    </p>
    <p>
      {laterModulesFollow}
      <a href="/product#later-modules-heading">They are named on the product page.</a>
    </p>
  </section>

  <section>
    <h2>Buying</h2>
    <p>
      {homeBuying}{" "}
      {trialNote}
    </p>
    <p><a href="/buying">How buying works</a></p>
  </section>

  <CtaRow quote={false} />
  <p>{homeClose}</p>
</BaseLayout>

<style>
  .intent-list {
    max-width: var(--measure);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .intent-list a {
    display: grid;
    gap: 0.15rem;
    color: var(--color-dark-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .intent-list a span {
    font-weight: 400;
  }

  .intent-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .scan-list {
    max-width: var(--measure);
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }
</style>
