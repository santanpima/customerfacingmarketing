---
import CtaRow from "../components/CtaRow.astro";
import CuiNotice from "../components/CuiNotice.astro";
import {
  assistantSummary,
  credentialsAndAudit,
  dataIsolation,
  fedrampShapeNote,
  includedWithLightScheduler,
  productBuild,
  securityLede,
  securityNotYet,
  seo,
  signInFact,
  signInGoogleCaveat,
  signInHow,
} from "../content/copy";
import BaseLayout from "../layouts/BaseLayout.astro";

const assistantIncluded = includedWithLightScheduler.find(
  (item) => item.name === "The Assistant",
);

const attachmentSentence = assistantIncluded?.summary
  .split(/(?<=\.)\s+/)
  .find((sentence) => sentence.startsWith("A file attached"));

if (!assistantIncluded?.summary.includes("every AI call is recorded")) {
  throw new Error("Assistant copy is missing the recorded-call clause.");
}

if (!attachmentSentence) {
  throw new Error("Assistant copy is missing the attachment sentence.");
}
---

<BaseLayout title={seo.security.title} description={seo.security.description}>
  <section class="band band-dark">
    <div class="inner">
      <h1>Security</h1>
      <p class="lede">{securityLede}</p>
    </div>
  </section>

  <section class="band">
    <div class="inner stack">
      <CuiNotice />
      <p>{fedrampShapeNote}</p>
      <div class="cell-grid">
        <section>
          <h2>How customer data is kept apart</h2>
          <p>{dataIsolation}</p>
        </section>
        <section>
          <h2>Credentials and audit</h2>
          <p>{credentialsAndAudit}</p>
        </section>
        <section>
          <h2>Sign-in</h2>
          <p>{signInHow}</p>
          <p>{signInFact}</p>
          <p>{signInGoogleCaveat}</p>
        </section>
        <section>
          <h2>The Assistant</h2>
          <p>{assistantSummary}</p>
          <p>Every AI call is recorded.</p>
          <p>{attachmentSentence}</p>
        </section>
        <section>
          <h2>Product build</h2>
          <p>{productBuild}</p>
        </section>
        <section>
          <h2>Not yet</h2>
          <p>{securityNotYet}</p>
          <p><a href="/contact">Contact</a></p>
        </section>
      </div>
      <CtaRow />
    </div>
  </section>
</BaseLayout>
