---
import CtaRow from "../components/CtaRow.astro";
import {
  accountShapeLead,
  accountShapes,
  aiCommercials,
  aiMetering,
  buyingLede,
  buyingOpen,
  enterpriseModulesNote,
  forSaleNowLead,
  functionsNote,
  laterModulesFollow,
  lightScheduler,
  paymentIntent,
  seo,
  trialNote,
  whatYouBuy,
} from "../content/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={seo.buying.title} description={seo.buying.description}>
  <section class="band band-dark">
    <div class="inner">
      <h1>How buying works</h1>
      <p class="lede">{buyingOpen}</p>
      <p class="lede">{buyingLede}</p>
      <CtaRow emphasis="equal" />
    </div>
  </section>

  <div class="band">
    <div class="inner stack">
      <div class="cell-grid">
        <section>
          <h2>What you buy</h2>
          <p>{whatYouBuy}</p>
        </section>
        <section>
          <h2>What you do not buy</h2>
          <p>{enterpriseModulesNote}</p>
          <p>{functionsNote}</p>
        </section>
        <section>
          <h2>How santan.ai intends to charge</h2>
          <p>{paymentIntent}</p>
        </section>
        <section>
          <h2>Trial</h2>
          <p>{trialNote}</p>
        </section>
      </div>

      <section>
        <h2>What is for sale now</h2>
        <p>
          {forSaleNowLead} {lightScheduler.summary} {laterModulesFollow} See the
          <a href="/product">product page</a>.
        </p>
      </section>

      <section>
        <h2>Account shape</h2>
        <p>{accountShapeLead}</p>
        <ul>
          {accountShapes.map((shape) => <li>{shape}</li>)}
        </ul>
      </section>

      <section>
        <h2>AI</h2>
        <p>{aiCommercials}</p>
        <p>{aiMetering}</p>
        <CtaRow emphasis="equal" />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  ul {
    max-width: var(--measure);
    margin: 0;
    padding-left: var(--space-md);
  }

  li + li {
    margin-top: var(--space-sm);
  }
</style>
